# API Configuration
ORCAROUTER_API_KEY=your_orcarouter_api_key_here
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
MODEL_NAME=z-ai/glm-5.3-flash-free

# Tokenizer Configuration
HF_TOKENIZER_REPO=THUDM/glm-4-9b-chat

# System Prompt
BASE_SYSTEM_PROMPT="You are a helpful and intelligent AI assistant."

# Context & Memory Limits
MAX_CONTEXT_TOKENS=250000
TOKEN_HEADROOM=8000
RECENT_BUFFER_COUNT=4
COMPACTION_TEMPERATURE=0.2

# Persistence
DATABASE_PATH=sessions.db
